<Window x:Class="PulseDashboard.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:comp="clr-namespace:PulseDashboard.Components"
        Title="Pulse Dashboard — WPF + Blazor Hybrid"
        Width="1280" Height="800" MinWidth="960" MinHeight="600"
        Background="#0F1923"
        WindowStartupLocation="CenterScreen">

    <!-- ARCH 2 — The entire UI is one control. WPF only provides the window; Blazor draws everything inside. -->
    <Grid>
        <blazor:BlazorWebView x:Name="BlazorView"
                              HostPage="wwwroot\index.html"
                              Services="{StaticResource services}">
            <blazor:BlazorWebView.RootComponents>
                <!-- Selector="#app" matches <div id="app"> in wwwroot/index.html -->
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type comp:DashboardRoot}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
